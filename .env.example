# Configuration de deploiement production (docker-compose.yml a la racine du depot).
#
# Usage : `cp .env.example .env`, remplir les valeurs marquees "A DEFINIR", puis
# `docker compose up -d --build`. Voir docs/DEPLOYMENT.md pour le guide complet.
#
# Ce fichier .env.example ne doit JAMAIS contenir de vraie cle/secret - seulement des exemples
# ou des valeurs vides. Le fichier .env reel (avec les vraies valeurs) ne doit jamais etre commite
# (deja exclu par .gitignore).

# --- Base de donnees --------------------------------------------------------------------------
POSTGRES_DB=comptable
POSTGRES_USER=comptable
# A DEFINIR : mot de passe fort et unique pour cet environnement.
POSTGRES_PASSWORD=

# --- Securite applicative ------------------------------------------------------------------------
# A DEFINIR : chaine aleatoire d'au moins 32 caracteres, unique par environnement (jamais la
# meme valeur qu'en developpement). Genere par exemple avec : openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# --- Exploitation pilote -------------------------------------------------------------------------------------
# prod (defaut) ou staging. En prod / staging le demarrage est REFUSE si un secret est faible (voir docs/operations/pilot-runbook.md).
SPRING_PROFILES_ACTIVE=prod
# Creation de cabinet reservee a l'operateur : PROVISIONING (defaut). Jeton exige par scripts/provision-cabinet.sh (24+ caracteres aleatoires, genere par generate-env.sh).
COMPTABLE_REGISTRATION_MODE=PROVISIONING
COMPTABLE_PROVISIONING_TOKEN=
# URL publique des liens de depot de pieces envoyes aux clients (obligatoire), ex. https://comptable.example.org/depot
COLLECTE_LIEN_DEPOT_BASE_URL=
# Envois aux clients (WhatsApp) : desactives par defaut. En staging / formation, ne renseigner QUE des numeros de test (chiffres, separes par des virgules).
COLLECTE_ENVOI_ACTIF=false
COLLECTE_RELANCE_ACTIF=false
COLLECTE_SANDBOX_ALLOWLIST=

# --- Secrets internes Java <-> Python (rotation independante, deux valeurs distinctes) -----------
# AI_SERVICE_OUTBOUND_API_KEY : verifie les appels backend -> ai-service (extraction, fraude,
# rapprochement, envoi WhatsApp). A DEFINIR : chaine aleatoire, ex. openssl rand -hex 32
AI_SERVICE_OUTBOUND_API_KEY=
# AI_SERVICE_INBOUND_API_KEY : verifie les appels ai-service -> backend (ingestion WhatsApp deja
# extraite/analysee). A DEFINIR, distincte de la precedente.
AI_SERVICE_INBOUND_API_KEY=

# --- Providers IA -------------------------------------------------------------------------------
# Groq : extraction VLM et analyse de fraude visuelle (aucun mode mock a ce niveau) - une piece
# contenant une image ne peut pas etre traitee sans cette cle. A DEFINIR pour activer AGENT_VLM_ENABLED.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Fournisseur IA des pieces/fraude : groq (defaut, necessite GROQ_API_KEY) ou bedrock (Amazon Bedrock : AUCUNE cle,
# role IAM de l'instance EC2 avec la permission bedrock:InvokeModel). BEDROCK_MODEL_ID = identifiant du modele ou
# du profil d'inference copie depuis la console Bedrock (ex. us.anthropic.claude-...).
VLM_PROVIDER=groq
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=

# Anthropic : Universal Matching Engine et Copilot uniquement, via AI_PROVIDER ci-dessous.
# Optionnel - laisser vide et AI_PROVIDER=mock (ou groq) pour ne pas en dependre.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# AI_PROVIDER : "mock" (aucune cle requise, reponses generiques/scriptees), "groq" (reutilise
# GROQ_API_KEY ci-dessus - une seule cle pour les quatre agents), "anthropic" (necessite
# ANTHROPIC_API_KEY) ou "bedrock" : le modele Amazon Bedrock de votre choix (Claude, Nova, Llama, Mistral...) pour toute la partie agentique (agent
# comptable autonome et sa boucle d'outils, CFO, copilot, matching, classification, sante financiere).
# Avec "bedrock" : AUCUNE cle, role IAM de l'instance EC2 (bedrock:InvokeModel + bedrock:Converse) et
# BEDROCK_MODEL_ID obligatoire (modele gerant outils + vision, acces active dans la console).
AI_PROVIDER=mock

AI_SERVICE_LOG_LEVEL=INFO
AI_SERVICE_CONNECT_TIMEOUT_MS=5000
AI_SERVICE_READ_TIMEOUT_MS=130000
RAPPROCHEMENT_SEUIL_CONFIANCE=0.90

# --- WhatsApp Cloud API (Meta) - optionnel, requis uniquement pour la boucle de relance --------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Telepaiement fiscal (Burkina Faso) - e-Syntaxe (DGI) et Faso Arzeka (La Poste BF) ----------
# Aucune des deux API n'est accessible a ce jour : ESYNTAXE_MODE/FASOARZEKA_MODE restent en
# "simulation" (par defaut, rien a renseigner ici) tant que l'acces n'a pas ete obtenu. Une fois
# obtenu, renseigner base-url/api-key ci-dessous et passer le mode correspondant a "reel" - voir
# comptable/src/main/java/.../fiscalite/paiement/provider/ pour le detail de l'integration.
ESYNTAXE_MODE=simulation
ESYNTAXE_BASE_URL=
ESYNTAXE_API_KEY=
FASOARZEKA_MODE=simulation
FASOARZEKA_BASE_URL=
FASOARZEKA_API_KEY=
# A DEFINIR pour activer le webhook de confirmation asynchrone (POST
# /api/webhooks/paiements/{fournisseur}) : chaine aleatoire, ex. openssl rand -hex 32. Vide par
# defaut, le webhook rejette alors tout appel (401).
PAIEMENT_WEBHOOK_API_KEY=

# --- Feature flags (comptable/DOCUMENTATION.md, section "Feature flags") -----------------------
# Toutes desactivees par defaut par securite - le comportement deterministe existant n'est jamais
# change silencieusement par un deploiement. A activer explicitement une fois les cles IA ci-dessus
# renseignees et le comportement verifie.
AGENT_VLM_ENABLED=false
AGENT_MATCHING_IA_ENABLED=false
AGENT_RAPPROCHEMENT_SEMANTIQUE_ENABLED=false
AGENT_ACCOUNTING_PROPOSAL_ENABLED=false
AGENT_FRAUDE_ANALYSE_VISUELLE_ENABLED=false

# Relance automatique des pieces en retard par WhatsApp - necessite un template approuve par Meta
# Business Manager (nom exact ci-dessous) et les variables WHATSAPP_* remplies.
RELANCE_ENABLED=false
RELANCE_CRON="0 0 8 * * *"
RELANCE_TEMPLATE_NAME=relance_pieces_comptables
RELANCE_TEMPLATE_LANGUAGE=fr

# --- Reseau ---------------------------------------------------------------------------------
# Deux modes de deploiement :
#
#   1. HTTP simple  (`make up` / `docker compose up -d --build`)
#      Le frontend nginx est expose directement sur HTTP_PORT. A utiliser en local, sur une IP
#      nue, ou derriere un reverse proxy externe qui gere deja le TLS.
#
#   2. Production HTTPS  (`make deploy` / `-f docker-compose.yml -f docker-compose.prod.yml`)
#      Un conteneur Caddy prend 80 + 443, obtient et renouvelle seul le certificat Let's Encrypt
#      pour DOMAIN, et relaie vers le frontend (qui n'est alors plus expose sur l'hote).
#      DOMAIN et ACME_EMAIL deviennent obligatoires dans ce mode.

# Mode 1 uniquement : port hote du frontend. Ignore en mode production (Caddy prend 80/443).
HTTP_PORT=80

# Mode 2 uniquement : nom de domaine qui pointe DEJA (enregistrement DNS A/AAAA) vers l'IP
# publique du serveur, et adresse e-mail pour les avis d'expiration de certificat Let's Encrypt.
DOMAIN=
ACME_EMAIL=
