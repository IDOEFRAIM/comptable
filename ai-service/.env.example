# Cle partagee que le service Spring Boot doit envoyer dans le header X-Internal-Api-Key
# sur chaque appel entrant (extraction, fraude, rapprochement). Meme secret cote Spring Boot
# (a ajouter dans application.properties, ex: ai-service.api-key=...).
INTERNAL_API_KEY=changeit-dev-secret

# Base URL du service coeur Spring Boot, utilisee par le microservice IA pour pousser les
# resultats d'ingestion WhatsApp (creation de document) une fois l'extraction terminee.
# CORE_SERVICE_API_KEY doit etre identique a ai-service.api-key (application.properties) /
# AI_SERVICE_API_KEY (env) cote Spring Boot.
CORE_SERVICE_BASE_URL=http://localhost:8080
CORE_SERVICE_API_KEY=changeit-dev-secret

# Anthropic - Universal Matching Engine et Copilot UNIQUEMENT (voir AI_PROVIDER ci-dessous).
# N'est plus utilise par l'extraction VLM ni l'analyse de fraude visuelle (voir GROQ_* plus bas).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Groq (extraction VLM, analyse de fraude visuelle) : seul provider vision de ces deux agents,
# aucun mode mock a ce niveau - une cle reelle est necessaire des qu'une piece image doit etre
# traitee. Ne jamais mettre de vraie cle dans ce fichier .env.example ni dans le code source.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Provider LLM du Universal Matching Engine UNIQUEMENT (extraction/fraude ne sont pas concernes,
# voir GROQ_* ci-dessus) : "mock" (par defaut) fait tourner tout le pipeline de rapprochement
# sans cle Anthropic, via app/services/mock_llm_provider.py - utile en developpement ou tant
# qu'aucun budget Anthropic n'est disponible. "anthropic" appelle reellement Claude et necessite
# ANTHROPIC_API_KEY ci-dessus. Ne jamais mettre de vraie cle dans ce fichier .env.example.
AI_PROVIDER=mock
# AI_PROVIDER=bedrock : le modele Bedrock de votre choix (Claude, Nova, Llama, Mistral...) pour TOUTE la partie agentique (agent comptable autonome
# et sa boucle d'outils, CFO, copilot, matching, classification, sante financiere). Aucune cle : boto3 prend
# le role IAM de l'instance EC2 (droits bedrock:InvokeModel + bedrock:Converse). Necessite BEDROCK_MODEL_ID.
#
# Amazon Bedrock : region, et ID du modele (ou du profil d'inference, prefixe eu./us./global.) tel
# qu'affiche dans la console Bedrock > Catalogue de modeles. Le modele doit gerer les outils (tool use) ET la vision
# (l'agent lit des images de pieces) et son acces doit etre active dans la console pour cette region.
# VLM_PROVIDER=bedrock envoie aussi l'extraction VLM et la fraude visuelle sur Bedrock (remplace Groq).
VLM_PROVIDER=groq
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=

# WhatsApp Cloud API (Meta) - memes valeurs que whatsapp.* cote Spring Boot avant extraction
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com

# Rapprochement semantique Mobile Money
RAPPROCHEMENT_SEUIL_CONFIANCE=0.90

ENVIRONMENT=local
LOG_LEVEL=INFO
